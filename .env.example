# Copy this file to .env in the repository root. Never commit .env.
#
# Scanner / runner containers consume the Codex and TypeSafe variables below.
# The findings-only service uses OPENAI_API_KEY/CODEX_API_KEY plus
# CODEX_SECURITY_EMBEDDINGS_URL for embeddings.

# --- Codex / OpenAI-compatible Responses API ---

# Primary API key. OPENAI_API_KEY wins when both keys are set.
OPENAI_API_KEY=
# CODEX_API_KEY=

# Optional base URL for the built-in OpenAI model provider.
# The endpoint must implement the OpenAI Responses API, not only Chat Completions.
# Example: https://api.openai.com/v1
OPENAI_BASE_URL=

# --- TypeSafe Jev bounded decision layer ---

# Enables Jev for dedupe screening and rubric-severity decisions.
TYPESAFE_API_KEY=

# Optional overrides. Empty/unset values use the defaults shown here.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# --- Findings embeddings ---

# Optional full embeddings endpoint URL. Empty/unset uses the OpenAI default.
# CODEX_SECURITY_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
